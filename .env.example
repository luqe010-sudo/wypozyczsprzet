# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MapTiler
NEXT_PUBLIC_MAPTILER_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://wypozycz.online
NEXT_PUBLIC_CONTACT_EMAIL=

# E-mail notifications (optional). Without RESEND_API_KEY inquiries are still saved and shown in the panels.
RESEND_API_KEY=
EMAIL_FROM=WypożyczSprzęt <powiadomienia@wypozycz.online>
ADMIN_NOTIFICATION_EMAIL=

# Protects /api/cron/freshness. Vercel sends it automatically as a Bearer token.
CRON_SECRET=

# Optional salt for hashing IP addresses in the inquiry rate limit.
IP_HASH_SALT=
